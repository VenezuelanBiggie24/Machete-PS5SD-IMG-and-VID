+void Pad::set_trigger_effect(std::uint32_t trigger_mask, std::uint32_t mode, std::uint8_t start_pos, std::uint8_t end_pos, std::uint8_t strength)
+{
+    if (handle_ < 0)
+        return;
+
+    static ScePadSetTriggerEffectFn s_setTriggerEffect = nullptr;
+    static bool s_triggerResolved = false;
+    if (!s_triggerResolved)
+    {
+        s_setTriggerEffect = reinterpret_cast<ScePadSetTriggerEffectFn>(dlsym(RTLD_DEFAULT, "scePadSetTriggerEffect"));
+        s_triggerResolved = true;
+    }
+
+    if (!s_setTriggerEffect)
+        return;
+
+    ScePadTriggerEffectParam param{};
+    param.triggerMask = trigger_mask;
+
+    for (int i = 0; i < 2; ++i)
+    {
+        if ((trigger_mask & (1 << i)) != 0)
+        {
+            param.command[i].mode = mode;
+            if (mode == 2) // WEAPON mode: snap/break
+            {
+                param.command[i].commandData.weaponParam.startPosition = start_pos;
+                param.command[i].commandData.weaponParam.endPosition   = end_pos;
+                param.command[i].commandData.weaponParam.strength      = strength;
+            }
+            else if (mode == 1) // FEEDBACK mode: continuous resistance
+            {
+                param.command[i].commandData.feedbackParam.position = start_pos;
+                param.command[i].commandData.feedbackParam.strength = strength;
+            }
+        }
+    }
+
+    const int res = s_setTriggerEffect(handle_, &param);
+    if (res != 0)
+        sys::log("[HUI] pad scePadSetTriggerEffect=0x%08x", static_cast<unsigned>(res));
+}
+
+void Pad::reset_trigger_effect()
+{
+    set_trigger_effect(3, 0, 0, 0, 0);
+}
